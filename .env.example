# Leer lassen erlaubt: dann wird der Schlüssel einmalig erzeugt und unter <MEMEOS_DATA_ROOT>/secret_key gespeichert
SECRET_KEY=dein-geheimer-schluessel
ADMIN_USERNAME=admin
# Ohne ADMIN_PASSWORD ist der Env-Login deaktiviert (dann Benutzer in der DB anlegen)
ADMIN_PASSWORD=sicheres-passwort

# Datenpfad für Uploads/Renders/Exports/Fonts/Imports UND die Datenbank (Standard: ./instance).
# Auf Render = gemountete Disk. Liegt unter ./instance noch eine memeos.db und im Datenpfad
# nicht, wird sie beim Start einmalig dorthin kopiert (die alte Datei bleibt liegen).
# MEMEOS_DATA_ROOT=/opt/render/project/src/instance
# DATABASE_URL hat Vorrang vor dem Datenpfad (z. B. sqlite:////pfad/zur/memeos.db oder Postgres)
# DATABASE_URL=

# Render-Queue (Bulk-Generator): Anzahl Worker-Threads im Prozess. 0 = aus (Tests/lokal),
# dann Aufträge von Hand über POST /api/render/run-once abarbeiten. Produktion: 3
MEMEOS_WORKERS=3
# Automatik-Thread (RSS-Feeds, Event-Erinnerung, Wetter-Events, Telegram-Digest/Rückmeldungen).
# 1 = an (Produktion), 0 = aus (Tests/lokal)
MEMEOS_SCHEDULER=1
# MEMEOS_OFFLINE=1  → Wetter-Job/Vorschau überspringen Open-Meteo (Tests ohne Netz)
# MEMEOS_VISION_MODEL=claude-haiku-4-5-20251001  → Modell für den Bild-Import (Standard wie angegeben)

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Canva API
CANVA_CLIENT_ID=...
CANVA_CLIENT_SECRET=...
CANVA_REFRESH_TOKEN=...

# ContentOS Bridge
CONTENT_OS_URL=https://content-os-0rjo.onrender.com
CONTENT_OS_KEY=optional-api-key

# RapidAPI (Inspiration-Abholung von Instagram-Seiten; einen Instagram-Scraper abonnieren).
# Alternativ im Dashboard unter Einstellungen → Integrationen speichern (hat Vorrang vor der Env-Variable).
RAPIDAPI_KEY=

# Cloudinary (Bildspeicherung)
# Unter cloudinary.com kostenlos registrieren → Dashboard → "API Environment variable" kopieren
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Deployment
BASE_URL=http://localhost:5200
